<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-users-table" author="nurlan">
        <createTable tableName="users">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(20)" defaultValue="USER">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


   <changeSet id="002-create-currencies-table" author="nurlan">
        <createTable tableName="currencies">
            <column name="code" type="CHAR(3)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="decimal_places" type="SMALLINT" defaultValueNumeric="2">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="currencies">
            <column name="code" value="USD"/>
            <column name="name" value="US Dollar"/>
            <column name="decimal_places" valueNumeric="2"/>
        </insert>
        <insert tableName="currencies">
            <column name="code" value="EUR"/>
            <column name="name" value="Euro"/>
            <column name="decimal_places" valueNumeric="2"/>
        </insert>
        <insert tableName="currencies">
            <column name="code" value="KZT"/>
            <column name="name" value="Kazakhstani Tenge"/>
            <column name="decimal_places" valueNumeric="2"/>
        </insert>
    </changeSet>
    <changeSet id="003-create-accounts-table" author="nurlan">
        <createTable tableName="accounts">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_accounts_user" references="users(id)"
                            unique="true" uniqueConstraintName="uq_accounts_user_currency"/>
            </column>
            <column name="currency" type="CHAR(3)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_accounts_user_currency"
                            foreignKeyName="fk_accounts_currency" references="currencies(code)"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="004-add-accounts-status-check" author="nurlan">
        <sql>
            ALTER TABLE accounts ADD CONSTRAINT chk_accounts_status
            CHECK (status IN ('ACTIVE', 'FROZEN', 'CLOSED'));
        </sql>
    </changeSet>
    <changeSet id="005-create-system-user" author="nurlan">
        <insert tableName="users">
            <column name="id" valueComputed="'00000000-0000-0000-0000-000000000001'::uuid"/>
            <column name="email" value="system@internal"/>
            <column name="password_hash" value="!"/>
            <column name="role" value="SYSTEM"/>
        </insert>
    </changeSet>
    <changeSet id="006-create-external-account" author="nurlan">
        <insert tableName="accounts">
            <column name="id" valueComputed="'00000000-0000-0000-0000-000000000002'::uuid"/>
            <column name="user_id" valueComputed="'00000000-0000-0000-0000-000000000001'::uuid"/>
            <column name="currency" value="USD"/>
            <column name="status" value="ACTIVE"/>
        </insert>
    </changeSet>
    <changeSet id="007-add-users-role-check" author="nurlan">
        <sql>
            ALTER TABLE users ADD CONSTRAINT chk_users_role
            CHECK (role IN ('USER', 'ADMIN', 'SYSTEM'));
        </sql>
    </changeSet>

    <changeSet id="008-create-transactions-table" author="nurlan">
        <createTable tableName="transactions">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="009-transaction-type-check" author="nurlan">
        <sql>
            ALTER TABLE transactions ADD CONSTRAINT chk_transaction_type
            CHECK (type IN ('TRANSFER', 'DEPOSIT', 'WITHDRAWAL'));
        </sql>
    </changeSet>
    <changeSet id="010-transaction-status-check" author="nurlan">
        <sql>
            ALTER TABLE transactions ADD CONSTRAINT chk_transaction_status
            CHECK (status IN ('PENDING', 'COMPLETED', 'FAILED'));
        </sql>
    </changeSet>
    <changeSet id="011-create-ledger-entries-table" author="nurlan">
        <createTable tableName="ledger_entries">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_ledger_transaction"
                            references="transactions(id)" deleteCascade="false"/>
            </column>
            <column name="account_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_ledger_account"
                            references="accounts(id)" deleteCascade="false"/>
            </column>
            <column name="amount" type="NUMERIC(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="entry_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="012-ledger-entry-type-check" author="nurlan">
        <sql>
            ALTER TABLE ledger_entries ADD CONSTRAINT chk_ledger_entry_type
            CHECK (entry_type IN ('DEBIT', 'CREDIT'));
        </sql>
    </changeSet>

    <changeSet id="013-ledger-amount-positive-check" author="nurlan">
        <sql>
            ALTER TABLE ledger_entries ADD CONSTRAINT chk_ledger_amount_positive
            CHECK (amount > 0);
        </sql>
    </changeSet>

    <changeSet id="014-ledger-entries-indexes" author="nurlan">
        <createIndex indexName="idx_ledger_account_id" tableName="ledger_entries">
            <column name="account_id"/>
        </createIndex>
        <createIndex indexName="idx_ledger_transaction_id" tableName="ledger_entries">
            <column name="transaction_id"/>
        </createIndex>
    </changeSet>
    

</databaseChangeLog>